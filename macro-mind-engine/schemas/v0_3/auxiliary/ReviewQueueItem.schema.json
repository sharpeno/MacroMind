{
  "$defs": {
    "ReviewStatus": {
      "enum": [
        "open",
        "resolved",
        "unknown"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "TimeReference": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded end, if known.",
          "field_origin": "implementation_extension",
          "title": "End"
        },
        "source_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence for this temporal expression.",
          "field_origin": "implementation_extension",
          "title": "Source Ref"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded start, if known.",
          "field_origin": "implementation_extension",
          "title": "Start"
        },
        "text": {
          "description": "Original temporal expression; no inferred exact date.",
          "field_origin": "implementation_extension",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TimeReference",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "unknown",
          "default": "unknown",
          "description": "Explicit known-but-undetermined value.",
          "field_origin": "implementation_extension",
          "title": "State",
          "type": "string"
        }
      },
      "title": "UnknownValue",
      "type": "object"
    }
  },
  "$id": "urn:macromind:ontology:0.3:schema:0.1.0:ReviewQueueItem",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Auxiliary mapping: frozen non-Core scope and validated MA.1; ontology_version=0.3.",
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Record creation time; None means not recorded.",
      "field_origin": "implementation_extension",
      "title": "Created At"
    },
    "decision_origin": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Decision source",
      "field_origin": "validated_auxiliary_contract",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Decision Origin"
    },
    "field_path": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Field or nested path needing review",
      "field_origin": "implementation_extension",
      "title": "Field Path"
    },
    "id": {
      "description": "Stable opaque identity. Display names do not establish identity.",
      "field_origin": "implementation_extension",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "default": {},
      "description": "Implementation metadata, never a substitute for canonical fields.",
      "field_origin": "implementation_extension",
      "title": "Metadata",
      "type": "object"
    },
    "object_type": {
      "const": "ReviewQueueItem",
      "default": "ReviewQueueItem",
      "description": "Registered object discriminator.",
      "field_origin": "implementation_extension",
      "title": "Object Type",
      "type": "string"
    },
    "observer": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Reviewer attribution",
      "field_origin": "validated_auxiliary_contract",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Observer"
    },
    "ontology_version": {
      "const": "0.3",
      "default": "0.3",
      "description": "Referenced frozen ontology version.",
      "field_origin": "implementation_extension",
      "title": "Ontology Version",
      "type": "string"
    },
    "provenance_refs": {
      "default": [],
      "description": "Provenance record references; empty means no refs recorded.",
      "field_origin": "implementation_extension",
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "reason": {
      "description": "Reason for review",
      "field_origin": "validated_auxiliary_contract",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Reason",
      "type": "string"
    },
    "resolved_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeReference"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Resolution time",
      "field_origin": "validated_auxiliary_contract",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Resolved At"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "description": "Implementation schema version, independent of ontology.",
      "field_origin": "implementation_extension",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus",
      "description": "Recorded review state; never waives schema validity",
      "field_origin": "implementation_extension"
    },
    "target_ref": {
      "description": "Target needing review",
      "field_origin": "validated_auxiliary_contract",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "id",
    "target_ref",
    "field_path",
    "reason",
    "status",
    "observer",
    "decision_origin",
    "resolved_at"
  ],
  "title": "ReviewQueueItem",
  "type": "object"
}
