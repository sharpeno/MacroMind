          389
        ],
        "博主认为基础设施配套可能改变新城市竞争优势，降低对原有自然交通节点的依赖。",
        "active"
      ],
      "quotes": [
        {
          "cue_id": 369,
          "time_range": "00:21:09,060 --> 00:21:14,920",
          "quote": "过去的时候呢，城市的产生是由于交通的便利，互相之间自然汇聚起来的。"
        },
        {
          "cue_id": 370,
          "time_range": "00:21:14,920 --> 00:21:18,200",
          "quote": "现在呢城市的产生，城市的繁荣可能呢。"
        },
        {
          "cue_id": 371,
          "time_range": "00:21:18,230 --> 00:21:23,820",
          "quote": "可以根据他自己一开始的先天优势来对吧？他一开始呢建的这种网络。"
        },
        {
          "cue_id": 372,
          "time_range": "00:21:23,820 --> 00:21:25,320",
          "quote": "非常非常的健全。"
        },
        {
          "cue_id": 373,
          "time_range": "00:21:25,320 --> 00:21:29,560",
          "quote": "在这样的网络的健全里面，适应现代的新兴的工业。"
        },
        {
          "cue_id": 380,
          "time_range": "00:21:46,630 --> 00:21:51,020",
          "quote": "现在物流的成本随着基建的投入，其实物流成本是下降很多的。"
        },
        {
          "cue_id": 381,
          "time_range": "00:21:51,020 --> 00:21:51,560",
          "quote": "是吧。"
        },
        {
          "cue_id": 382,
          "time_range": "00:21:51,560 --> 00:21:54,250",
          "quote": "你在这个地方或者那个地方，交通枢纽互相之间。"
        },
        {
          "cue_id": 383,
          "time_range": "00:21:54,250 --> 00:22:00,530",
          "quote": "你完全可以，如果真的有这个需求的话，我多修几条路，花这的钱不多的，然后我就可以把这个。"
        },
        {
          "cue_id": 384,
          "time_range": "00:22:00,530 --> 00:22:03,120",
          "quote": "城市的这个交通的这个情况改善了很多。"
        },
        {
          "cue_id": 385,
          "time_range": "00:22:03,120 --> 00:22:04,780",
          "quote": "那决定这些城市。"
        },
        {
          "cue_id": 386,
          "time_range": "00:22:04,780 --> 00:22:07,030",
          "quote": "未来发展的潜力的或者说呢。"
        },
        {
          "cue_id": 387,
          "time_range": "00:22:07,030 --> 00:22:10,330",
          "quote": "决定这些城市里边未来跟其他城市之间竞争的。"
        },
        {
          "cue_id": 388,
          "time_range": "00:22:10,330 --> 00:22:13,770",
          "quote": "实际上就是先天的这个硬件配套到底修的怎么样？"
        },
        {
          "cue_id": 389,
          "time_range": "00:22:13,770 --> 00:22:15,700",
          "quote": "喜欢给的是这样的一个答案。"
        }
      ],
      "context": [
