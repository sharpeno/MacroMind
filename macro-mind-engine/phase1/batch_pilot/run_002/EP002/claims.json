  },
  {
    "claim_id": "EP002/C09",
    "normalized_statement": "博主认为公司发行债券会与国债争夺资金。",
    "quotes": [
      {
        "cue_id": 195,
        "time_range": "00:09:17,810 --> 00:09:20,810",
        "quote": "美债之所以现在这么的难卖。"
      },
      {
        "cue_id": 196,
        "time_range": "00:09:20,810 --> 00:09:23,710",
        "quote": "不就是公司债充斥在这个市场上面。"
      },
      {
        "cue_id": 197,
        "time_range": "00:09:23,710 --> 00:09:27,140",
        "quote": "把很多很多潜在的美债买家吸引走了嘛。"
      },
      {
        "cue_id": 198,
        "time_range": "00:09:27,150 --> 00:09:29,780",
        "quote": "买家没有了，那自然而然就难卖了嘛。"
      },
      {
        "cue_id": 199,
        "time_range": "00:09:29,780 --> 00:09:33,890",
        "quote": "本来过去是一个交易，双方平衡的买卖双方平衡的市场。"
      }
    ],
    "initial_disposition": "active",
    "numeric_policy": "All literal numbers, units, modal and negation tokens remain in unmodified quotes; no inferred conversion.",
    "assertion_time": "UNKNOWN",
