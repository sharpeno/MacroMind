{
  "schema": "macromind.framework-review.v1",
  "review_id": "v03_draft_001",
  "draft_sha256": "9301ba9a3e9621a413418173462282cff1d7e8bbd64f87207c631f32561a5093",
  "cards": [
    {
      "id": "C01",
      "target": "M02",
      "title": "承诺与支持到了哪一步？",
      "rule": "把表态、承诺范围、资金或物资、组织安排、实际执行和效果分开，再判断是否真正加大支持。",
      "inputs": [
        "谁对谁支持，公开说了什么",
        "新增资源、执行迹象、观察截止日"
      ],
      "steps": [
        "先说明本次下场或升级具体指什么，不能事后换口径",
        "比较既有支持与新增投入；同一行动可以有多个作用",
        "给出当前已到哪一步，以及对下一步的倾向"
      ],
      "default": "有明确承诺可先视为约束；尚无执行证据时，不提前计入执行收益，也不断言不会执行。",
      "update": "新增拨款、部署、撤回承诺或可观察执行出现时更新；表态与执行冲突时保留冲突。",
      "example": "教学例：某机构承诺援助但未见交付，可判断存在援助意向和政治约束；交付能力与实际作用仍未知。",
      "boundary": "把新增拨款作为博主该例的观察指标，不能规定所有介入都必须有新增拨款；威慑与约束盟友可并存。",
      "evidence": [
        {
          "unit": "U01",
          "episode": "456",
          "cues": [
            {
              "cue": 14,
              "time": "00:00:33.10 --> 00:00:34.06",
              "text": "美国下场了"
            },
            {
              "cue": 15,
              "time": "00:00:34.06 --> 00:00:35.02",
              "text": "其实不是哈"
            },
            {
              "cue": 16,
              "time": "00:00:35.02 --> 00:00:37.08",
              "text": "这里边的话要澄清一下"
            },
            {
              "cue": 17,
              "time": "00:00:37.32 --> 00:00:38.79",
              "text": "美国下没下场"
            },
            {
              "cue": 18,
              "time": "00:00:38.79 --> 00:00:40.86",
              "text": "最关键的一个指标是什么"
            },
            {
              "cue": 19,
              "time": "00:00:40.86 --> 00:00:43.59",
              "text": "不是看他的军事力量怎么行动"
            },
            {
              "cue": 20,
              "time": "00:00:43.59 --> 00:00:46.53",
              "text": "而是要看他国会这边的拨款怎么走"
            },
            {
              "cue": 21,
              "time": "00:00:46.53 --> 00:00:48.69",
              "text": "你始终记得看美国的行为"
            },
            {
              "cue": 22,
              "time": "00:00:48.69 --> 00:00:49.65",
              "text": "不要看他怎么说"
            },
            {
              "cue": 23,
              "time": "00:00:49.65 --> 00:00:51.57",
              "text": "要看他怎么做怎么做"
            },
            {
              "cue": 24,
              "time": "00:00:51.57 --> 00:00:52.83",
              "text": "关键的行为啊"
            },
            {
              "cue": 25,
              "time": "00:00:52.83 --> 00:00:56.19",
              "text": "量肌肉这一方面花钱是另外一方面"
            },
            {
              "cue": 26,
              "time": "00:00:56.19 --> 00:00:58.59",
              "text": "花钱是有功率很高于量肌肉的"
            },
            {
              "cue": 27,
              "time": "00:00:58.59 --> 00:01:0.33",
              "text": "而对于以色列来说的话"
            },
            {
              "cue": 28,
              "time": "00:01:0.33 --> 00:01:3.82",
              "text": "实际上美国在前几次的这中东战争"
            }
          ]
        },
        {
          "unit": "U22",
          "episode": "465",
          "cues": [
            {
              "cue": 65,
              "time": "00:02:42.82 --> 00:02:45.07",
              "text": "我只能通过这种具体的事件"
            },
            {
              "cue": 66,
              "time": "00:02:45.07 --> 00:02:47.17",
              "text": "来表示我的这个不满是吧"
            },
            {
              "cue": 67,
              "time": "00:02:47.17 --> 00:02:49.06",
              "text": "那反过来你再想想看"
            },
            {
              "cue": 68,
              "time": "00:02:49.06 --> 00:02:50.98",
              "text": "美国的航空母舰到底对着谁"
            },
            {
              "cue": 69,
              "time": "00:02:50.98 --> 00:02:52.75",
              "text": "其实这个答案就呼之欲出了"
            },
            {
              "cue": 70,
              "time": "00:02:52.75 --> 00:02:55.32",
              "text": "这里的话我额外的就解释一句哈"
            },
            {
              "cue": 71,
              "time": "00:02:55.32 --> 00:02:59.46",
              "text": "我说美国的航空母舰跑到地中海这边来"
            },
            {
              "cue": 72,
              "time": "00:02:59.46 --> 00:03:1.03",
              "text": "是一个督军的作用"
            },
            {
              "cue": 73,
              "time": "00:03:1.03 --> 00:03:4.30",
              "text": "并不是指这个航空母舰唯一的作用是督军"
            },
            {
              "cue": 74,
              "time": "00:03:4.30 --> 00:03:6.61",
              "text": "千万不要这种二极管的思维"
            },
            {
              "cue": 75,
              "time": "00:03:6.61 --> 00:03:7.93",
              "text": "而是之前的时候呢"
            },
            {
              "cue": 76,
              "time": "00:03:7.93 --> 00:03:11.54",
              "text": "大家都说这个航空母舰过来是为了压服啊"
            },
            {
              "cue": 77,
              "time": "00:03:11.54 --> 00:03:13.04",
              "text": "其他的这些反对势力呢"
            },
            {
              "cue": 78,
              "time": "00:03:13.04 --> 00:03:15.41",
              "text": "让这些中东这些国家不敢轻举妄动的"
            },
            {
              "cue": 79,
              "time": "00:03:15.41 --> 00:03:17.00",
              "text": "然后呢我就补充了一点"
            },
            {
              "cue": 80,
              "time": "00:03:17.00 --> 00:03:19.12",
              "text": "我说在这个基础之上呢"
            },
            {
              "cue": 81,
              "time": "00:03:19.12 --> 00:03:20.14",
              "text": "更大的作用"
            },
            {
              "cue": 82,
              "time": "00:03:20.14 --> 00:03:22.85",
              "text": "其实这个这把剑是朝着以色列的"
            },
            {
              "cue": 83,
              "time": "00:03:22.85 --> 00:03:23.90",
              "text": "是这个意思"
            },
            {
              "cue": 84,
              "time": "00:03:23.90 --> 00:03:26.48",
              "text": "并不是说这把剑的唯一功能"
            },
            {
              "cue": 85,
              "time": "00:03:26.48 --> 00:03:27.98",
              "text": "就是为了逼迫以色列"
            },
            {
              "cue": 86,
              "time": "00:03:27.98 --> 00:03:30.23",
              "text": "你说美国逼迫以色列对吧"
            },
            {
              "cue": 87,
              "time": "00:03:30.23 --> 00:03:31.94",
              "text": "拿着航母母舰在这里晃"
            }
          ]
        }
      ],
      "attribution": {
        "rule": "ASSISTANT_OPERATIONALIZATION_BASED_ON_BLOGGER",
        "boundary": "ASSISTANT_EVIDENCE_SAFEGUARD",
        "approval": "PENDING"
      }
    },
    {
      "id": "C02",
      "target": "M01",
      "title": "谁想做、谁能做、谁能阻止？",
      "rule": "分析各方的利益、能力和依赖，也看同一主体内部的分歧，以及能阻碍安排的参与者。",
      "inputs": [
        "参与者、内部决策者与执行方",
        "已知收益、代价、资源、外部依赖和替代选择"
      ],
      "steps": [
        "分别列出动机与能力，不把国家或机构当成完全一致的一个人",
        "找出维持现状、升级、缓和各自的推动者和阻碍者",
        "比较约束强弱，形成有条件的倾向，注明未知环节"
      ],
      "default": "已有行为与约束足以支持排序时给出暂时倾向；其余环节列为假说，不因信息不全停止所有推演。",
      "update": "关键参与者改变态度、约束减弱、资源变化或出现新阻挠者时调整排序。",
      "example": "教学例：两方有合作意愿，但负责执行的部门会受损；先判断落实阻力较大，并观察补偿或协调安排。",
      "boundary": "不能凭制度标签或民族性格代替证据；有破坏能力不等于能完全控制事件方向。",
      "evidence": [
        {
          "unit": "U15",
          "episode": "460",
          "cues": [
            {
              "cue": 499,
              "time": "00:17:53.58 --> 00:17:55.59",
              "text": "而且那美国对你的这个要求"
            },
            {
              "cue": 500,
              "time": "00:17:55.59 --> 00:17:58.33",
              "text": "其实跟你自己内部的这个诉求是一致的呀"
            },
            {
              "cue": 501,
              "time": "00:17:58.33 --> 00:18:0.55",
              "text": "美国说那你去跟以色列欧过手是吧"
            },
            {
              "cue": 502,
              "time": "00:18:0.55 --> 00:18:1.69",
              "text": "谈一谈合作的事"
            },
            {
              "cue": 503,
              "time": "00:18:1.69 --> 00:18:2.86",
              "text": "谈一谈和平的事"
            },
            {
              "cue": 504,
              "time": "00:18:2.86 --> 00:18:5.17",
              "text": "那沙特去做了这个事儿有什么影响呢"
            },
            {
              "cue": 505,
              "time": "00:18:5.17 --> 00:18:6.68",
              "text": "而且沙特还做了对冲啊"
            },
            {
              "cue": 506,
              "time": "00:18:6.68 --> 00:18:8.36",
              "text": "美国这边一来是吧"
            },
            {
              "cue": 507,
              "time": "00:18:8.36 --> 00:18:10.34",
              "text": "要拉拢沙特跟以色列和谈"
            },
            {
              "cue": 508,
              "time": "00:18:10.34 --> 00:18:13.62",
              "text": "沙特马上就派大使到巴勒斯坦去了对吧"
            },
            {
              "cue": 509,
              "time": "00:18:13.62 --> 00:18:15.78",
              "text": "8月14号的那个344期"
            },
            {
              "cue": 510,
              "time": "00:18:15.78 --> 00:18:17.70",
              "text": "你可以有兴趣可以翻一下那些是吧"
            }
          ]
        },
        {
          "unit": "U35",
          "episode": "470",
          "cues": [
            {
              "cue": 120,
              "time": "00:04:29.82 --> 00:04:31.32",
              "text": "看看我的节目啊"
            },
            {
              "cue": 121,
              "time": "00:04:31.32 --> 00:04:32.52",
              "text": "前面的话都聊过"
            },
            {
              "cue": 122,
              "time": "00:04:32.52 --> 00:04:32.76",
              "text": "巴西"
            },
            {
              "cue": 123,
              "time": "00:04:32.76 --> 00:04:33.78",
              "text": "也聊过印度聊过"
            },
            {
              "cue": 124,
              "time": "00:04:33.78 --> 00:04:36.26",
              "text": "其实这些呢都是区域大国"
            },
            {
              "cue": 125,
              "time": "00:04:36.42 --> 00:04:38.10",
              "text": "他想做好事的时候"
            },
            {
              "cue": 126,
              "time": "00:04:38.10 --> 00:04:38.94",
              "text": "力量是不够的"
            },
            {
              "cue": 127,
              "time": "00:04:38.94 --> 00:04:39.48",
              "text": "因为什么呢"
            },
            {
              "cue": 128,
              "time": "00:04:39.48 --> 00:04:40.98",
              "text": "因为做好事把事情啊"
            },
            {
              "cue": 129,
              "time": "00:04:40.98 --> 00:04:43.68",
              "text": "做好的这个通道掌握在美国手里"
            },
            {
              "cue": 130,
              "time": "00:04:43.68 --> 00:04:46.63",
              "text": "就美国的这个现有的这个世界秩序嘛"
            },
            {
              "cue": 131,
              "time": "00:04:46.63 --> 00:04:48.25",
              "text": "但是呢他想坏事"
            },
            {
              "cue": 132,
              "time": "00:04:48.25 --> 00:04:49.27",
              "text": "把这一个地方啊"
            }
          ]
        }
      ],
      "attribution": {
        "rule": "ASSISTANT_OPERATIONALIZATION_BASED_ON_BLOGGER",
        "boundary": "ASSISTANT_EVIDENCE_SAFEGUARD",
        "approval": "PENDING"
      }
    },
    {
      "id": "C03",
      "target": "M03",
      "title": "如何从行为与多种线索推断？",
      "rule": "用公开行为、不同指标和文本对照形成解释，并检查同样现象还能由什么原因造成。",
      "inputs": [
        "可追溯的行为、文本或指标",
        "历史基准、来源关系、至少一种竞争解释"
      ],
      "steps": [
        "说明观察与常态的差异，比较哪些解释更能说明差异",
        "允许从决策反推动机或信息优势，但标明这是推断",
        "检查反证；区分资源支持、事前知情和直接指挥"
      ],
      "default": "可以给出最值得优先考虑的解释，不要求先找到内部文件；证据薄弱时降低确信程度并保留替代解释。",
      "update": "出现能区分解释的新证据时重新排序；若反证也被解释成支持，先检查是否形成无法证伪的循环。",
      "example": "教学例：某方提前准备多个方案，可暂推断其较早意识到风险；也可能是常规预案，后续需比较准备时间与日常标准。",
      "boundary": "多条同源措辞不等于多份独立证据；拟合现象不证明唯一因果。该限制是系统的证据要求，不声称博主始终遵守。",
      "evidence": [
        {
          "unit": "U14",
          "episode": "460",
          "cues": [
            {
              "cue": 76,
              "time": "00:03:9.38 --> 00:03:10.36",
              "text": "这是在干嘛呀"
            },
            {
              "cue": 77,
              "time": "00:03:10.36 --> 00:03:12.28",
              "text": "极限拉扯呀对吧"
            },
            {
              "cue": 78,
              "time": "00:03:12.28 --> 00:03:13.36",
              "text": "那钓鱼嘛"
            },
            {
              "cue": 79,
              "time": "00:03:13.36 --> 00:03:15.31",
              "text": "一会儿呢鱼线要松下来"
            },
            {
              "cue": 80,
              "time": "00:03:15.31 --> 00:03:16.90",
              "text": "一会儿呢鱼线要紧一点啊"
            },
            {
              "cue": 81,
              "time": "00:03:16.90 --> 00:03:17.96",
              "text": "极限拉扯"
            },
            {
              "cue": 82,
              "time": "00:03:17.96 --> 00:03:19.31",
              "text": "你越拉扯呢"
            },
            {
              "cue": 83,
              "time": "00:03:19.31 --> 00:03:20.72",
              "text": "这个松紧之间呢"
            },
            {
              "cue": 84,
              "time": "00:03:20.72 --> 00:03:23.69",
              "text": "这个钩呢就挂的越瓷实是吧"
            },
            {
              "cue": 85,
              "time": "00:03:23.69 --> 00:03:24.65",
              "text": "钩的越深"
            },
            {
              "cue": 86,
              "time": "00:03:24.65 --> 00:03:27.18",
              "text": "这个鱼呢就越不可能脱钩是吧"
            },
            {
              "cue": 87,
              "time": "00:03:27.42 --> 00:03:29.10",
              "text": "看到这些迹象呢"
            },
            {
              "cue": 88,
              "time": "00:03:29.10 --> 00:03:31.26",
              "text": "其实呢这是我个人的观点啊"
            },
            {
              "cue": 89,
              "time": "00:03:31.26 --> 00:03:33.84",
              "text": "不存在任何其他的这个暗示哈"
            },
            {
              "cue": 90,
              "time": "00:03:33.84 --> 00:03:37.39",
              "text": "那我认为呢伊朗在这件事情背后啊"
            },
            {
              "cue": 91,
              "time": "00:03:37.39 --> 00:03:40.40",
              "text": "是铁定百分之百跑不了的啊"
            },
            {
              "cue": 92,
              "time": "00:03:40.40 --> 00:03:42.32",
              "text": "你别说什么跑得了的话"
            },
            {
              "cue": 93,
              "time": "00:03:42.32 --> 00:03:44.05",
              "text": "你别说什么跟你没关系的话"
            },
            {
              "cue": 94,
              "time": "00:03:44.05 --> 00:03:45.88",
              "text": "你在这里极限配合拉扯"
            },
            {
              "cue": 95,
              "time": "00:03:45.88 --> 00:03:47.97",
              "text": "那就是醉翁之意不在酒是吧"
            }
          ]
        },
        {
          "unit": "U13",
          "episode": "460",
          "cues": [
            {
              "cue": 35,
              "time": "00:01:33.06 --> 00:01:35.19",
              "text": "一边的话是以色列和美国哈"
            },
            {
              "cue": 36,
              "time": "00:01:35.19 --> 00:01:38.77",
              "text": "然后第三个呢是一个特别有意思的传闻"
            },
            {
              "cue": 37,
              "time": "00:01:38.77 --> 00:01:40.27",
              "text": "这个传闻没有得到证实"
            },
            {
              "cue": 38,
              "time": "00:01:40.27 --> 00:01:43.06",
              "text": "但是呢西方媒体疯传什么呢"
            },
            {
              "cue": 39,
              "time": "00:01:43.06 --> 00:01:46.73",
              "text": "沙特终止了跟以色列的这个和平谈判"
            },
            {
              "cue": 40,
              "time": "00:01:46.73 --> 00:01:49.19",
              "text": "就是两个国家要国家正常化"
            },
            {
              "cue": 41,
              "time": "00:01:49.19 --> 00:01:50.96",
              "text": "沙特这边完全终止了"
            },
            {
              "cue": 42,
              "time": "00:01:50.96 --> 00:01:54.68",
              "text": "然后呢就把沙特终于签到这个局面来"
            },
            {
              "cue": 43,
              "time": "00:01:54.68 --> 00:01:55.76",
              "text": "之前的时候呢"
            }
          ]
        }
      ],
      "attribution": {
        "rule": "ASSISTANT_OPERATIONALIZATION_BASED_ON_BLOGGER",
        "boundary": "ASSISTANT_EVIDENCE_SAFEGUARD",
        "approval": "PENDING"
      }
    },
    {
      "id": "C04",
      "target": "M04",
      "title": "新闻如何传到实际影响？",
      "rule": "分别推演短期情绪、实际供需、对冲措施及后续反馈，允许条件改变后影响反向。",
      "inputs": [
        "受影响对象、时间范围与计量口径",
        "供应需求、替代方案、执行时滞和传导环节"
      ],
      "steps": [
        "列出事件到结果之间的必要环节",
        "区分公告、可执行能力与已实现效果",
        "给出基础情景、替代分支和方向反转条件"
      ],
