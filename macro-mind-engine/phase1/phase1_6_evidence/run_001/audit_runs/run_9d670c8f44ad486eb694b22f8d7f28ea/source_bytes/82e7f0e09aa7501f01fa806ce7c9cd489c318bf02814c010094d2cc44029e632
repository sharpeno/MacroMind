      "source_id": "S08",
      "source_segment_id": "SS-X09",
      "surface_text": null,
      "paraphrase": "Platts即日起排除部分须通过海峡的港口成品油MOC买卖报价，相关价格评估继续。",
      "occurrence_type": "first",
      "information_gain": "high"
    },
    {
