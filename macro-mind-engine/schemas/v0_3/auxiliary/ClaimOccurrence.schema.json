{
  "$defs": {
    "TimeReference": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded end, if known.",
          "field_origin": "implementation_extension",
          "title": "End"
        },
        "source_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence for this temporal expression.",
          "field_origin": "implementation_extension",
          "title": "Source Ref"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded start, if known.",
          "field_origin": "implementation_extension",
          "title": "Start"
        },
        "text": {
          "description": "Original temporal expression; no inferred exact date.",
          "field_origin": "implementation_extension",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TimeReference",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "unknown",
          "default": "unknown",
          "description": "Explicit known-but-undetermined value.",
          "field_origin": "implementation_extension",
          "title": "State",
          "type": "string"
        }
      },
      "title": "UnknownValue",
      "type": "object"
    }
  },
  "$id": "urn:macromind:ontology:0.3:schema:0.1.0:ClaimOccurrence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Auxiliary mapping: frozen non-Core scope and validated MA.1; ontology_version=0.3.",
  "properties": {
    "asserted_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeReference"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Occurrence assertion time",
      "field_origin": "validated_auxiliary_contract",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Asserted At"
    },
    "claim_ref": {
      "description": "Canonical proposition",
      "field_origin": "validated_auxiliary_contract",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Claim Ref",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Record creation time; None means not recorded.",
      "field_origin": "implementation_extension",
      "title": "Created At"
    },
    "id": {
      "description": "Stable opaque identity. Display names do not establish identity.",
      "field_origin": "implementation_extension",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "default": {},
      "description": "Implementation metadata, never a substitute for canonical fields.",
      "field_origin": "implementation_extension",
      "title": "Metadata",
      "type": "object"
    },
    "object_type": {
      "const": "ClaimOccurrence",
      "default": "ClaimOccurrence",
      "description": "Registered object discriminator.",
      "field_origin": "implementation_extension",
      "title": "Object Type",
      "type": "string"
    },
    "ontology_version": {
      "const": "0.3",
      "default": "0.3",
      "description": "Referenced frozen ontology version.",
      "field_origin": "implementation_extension",
      "title": "Ontology Version",
      "type": "string"
    },
    "origin_family_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Proposition origin family",
      "field_origin": "validated_auxiliary_contract",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Origin Family Ref"
    },
    "provenance_refs": {
      "default": [],
      "description": "Provenance record references; empty means no refs recorded.",
      "field_origin": "implementation_extension",
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "description": "Implementation schema version, independent of ontology.",
      "field_origin": "implementation_extension",
      "title": "Schema Version",
      "type": "string"
    },
    "source_segment_ref": {
      "description": "Specific occurrence location",
      "field_origin": "validated_auxiliary_contract",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Source Segment Ref",
      "type": "string"
    },
    "source_version_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Recorded source version",
      "field_origin": "validated_auxiliary_contract",
      "source_ref": "Frozen auxiliary scope/P13/P15; MA.1 accepted auxiliary contract",
      "title": "Source Version Ref"
    }
  },
  "required": [
    "id",
    "claim_ref",
    "source_segment_ref",
    "source_version_ref",
    "origin_family_ref",
    "asserted_at"
  ],
  "title": "ClaimOccurrence",
  "type": "object"
}
