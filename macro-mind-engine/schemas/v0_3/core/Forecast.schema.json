{
  "$defs": {
    "AnalysisContext": {
      "enum": [
        "historical_reconstruction",
        "historical_reconstruction_and_method_observation",
        "method_observation_after_argument_extraction",
        "model_diagnostic",
        "verification_not_creator_reconstruction",
        "unknown"
      ],
      "title": "AnalysisContext",
      "type": "string"
    },
    "ResolutionCriteria": {
      "additionalProperties": false,
      "properties": {
        "analysis_context": {
          "$ref": "#/$defs/AnalysisContext",
          "description": "Criterion origin context.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "P15"
        },
        "approved_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeReference"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Approval time, independent of evaluation time.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "P13",
          "title": "Approved At"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original or explicitly attributed resolution criterion.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "Forecast/P13",
          "title": "Description"
        },
        "evaluation_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeReference"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual evaluation time.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "P13",
          "title": "Evaluation Time"
        },
        "reasoner_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Criterion originator; creator/model/human kept distinct.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "P15",
          "title": "Reasoner Id"
        },
        "scoring_permitted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded scoring permission; no automatic approval.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "Forecast temporal contract",
          "title": "Scoring Permitted"
        },
        "set_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeReference"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time criterion was set.",
          "field_origin": "frozen_semantic_requirement",
          "source_ref": "P13",
          "title": "Set At"
        }
      },
      "required": [
        "description",
        "reasoner_id",
        "analysis_context",
        "set_at",
        "approved_at",
        "evaluation_time",
        "scoring_permitted"
      ],
      "title": "ResolutionCriteria",
      "type": "object"
    },
    "ResolutionStatus": {
      "enum": [
        "not_applicable",
        "not_evaluated",
        "not_yet_evaluated",
        "pending_review",
        "unknown"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "TimeReference": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded end, if known.",
          "field_origin": "implementation_extension",
          "title": "End"
        },
        "source_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence for this temporal expression.",
          "field_origin": "implementation_extension",
          "title": "Source Ref"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded start, if known.",
          "field_origin": "implementation_extension",
          "title": "Start"
        },
        "text": {
          "description": "Original temporal expression; no inferred exact date.",
          "field_origin": "implementation_extension",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TimeReference",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "unknown",
          "default": "unknown",
          "description": "Explicit known-but-undetermined value.",
          "field_origin": "implementation_extension",
          "title": "State",
          "type": "string"
        }
      },
      "title": "UnknownValue",
      "type": "object"
    }
  },
  "$id": "urn:macromind:ontology:0.3:schema:0.1.0:Forecast",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen object definition: core_objects.json#Forecast; ontology_version=0.3.",
  "properties": {
    "branch_selection": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Recorded branch selection without inferring endorsement",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Branch Selection"
    },
    "claim_ref": {
      "description": "Subject's future judgment expressed by Claim",
      "field_origin": "frozen_semantic_requirement",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Claim Ref",
      "type": "string"
    },
    "claimant": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Subject assuming the judgment",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Claimant"
    },
    "conditions": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Conditions of judgment",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Conditions"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Record creation time; None means not recorded.",
      "field_origin": "implementation_extension",
      "title": "Created At"
    },
    "id": {
      "description": "Stable opaque identity. Display names do not establish identity.",
      "field_origin": "implementation_extension",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Id",
      "type": "string"
    },
    "knowledge_cutoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeReference"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Knowledge cutoff, not evaluation time",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Knowledge Cutoff"
    },
    "metadata": {
      "additionalProperties": true,
      "default": {},
      "description": "Implementation metadata, never a substitute for canonical fields.",
      "field_origin": "implementation_extension",
      "title": "Metadata",
      "type": "object"
    },
    "modal_strength": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original modality",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Modal Strength"
    },
    "object_type": {
      "const": "Forecast",
      "default": "Forecast",
      "description": "Registered object discriminator.",
      "field_origin": "implementation_extension",
      "title": "Object Type",
      "type": "string"
    },
    "ontology_version": {
      "const": "0.3",
      "default": "0.3",
      "description": "Referenced frozen ontology version.",
      "field_origin": "implementation_extension",
      "title": "Ontology Version",
      "type": "string"
    },
    "prediction_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeReference"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Prediction window; unknown allowed",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Prediction Window"
    },
    "provenance_refs": {
      "default": [],
      "description": "Provenance record references; empty means no refs recorded.",
      "field_origin": "implementation_extension",
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "resolution_criteria": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolutionCriteria"
        },
        {
          "$ref": "#/$defs/UnknownValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Criteria and origin; unknown allowed",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Resolution Criteria"
    },
    "resolution_status": {
      "$ref": "#/$defs/ResolutionStatus",
      "description": "Recorded resolution status",
      "field_origin": "frozen_semantic_requirement",
      "source_ref": "core_objects.json#Forecast; core_principles.json"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "description": "Implementation schema version, independent of ontology.",
      "field_origin": "implementation_extension",
      "title": "Schema Version",
      "type": "string"
    },
    "source_refs": {
      "description": "Original judgment sources",
      "field_origin": "frozen_semantic_requirement",
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "source_ref": "core_objects.json#Forecast; core_principles.json",
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "id",
    "claim_ref",
    "knowledge_cutoff",
    "prediction_window",
    "modal_strength",
    "resolution_criteria",
    "claimant",
    "conditions",
    "branch_selection",
    "resolution_status",
    "source_refs"
  ],
  "title": "Forecast",
  "type": "object"
}
