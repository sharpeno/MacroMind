[
  {
    "claim_id": "EP002/C01",
    "normalized_statement": "本期决策尚未公布；博主讨论的是预期，不是已经发生的加息。",
    "quotes": [
      {
        "cue_id": 1,
        "time_range": "00:00:00,280 --> 00:00:20,280",
        "quote": "大家好，今天跟大家聊聊美联储加息的预期哈。按照目前市场交易的结果的话，现在市场基本上默认了星期四的凌晨2点钟，美联储这边会宣布加息25个BP啊啊这个加息的决策呢，其实我在今年的年初就跟大家提前的预计过了。"
      },
      {
        "cue_id": 9,
        "time_range": "00:01:09,380 --> 00:01:13,790",
        "quote": "现在市场交易的方向绑架着卧室，现在结果还没出来啊。"
      },
      {
        "cue_id": 10,
        "time_range": "00:01:13,790 --> 00:01:18,350",
        "quote": "卧实会不会加息，还是两说啊，但是大概率它是胳膊拧不过大腿的，因为。"
      },
      {
        "cue_id": 263,
        "time_range": "00:11:58,090 --> 00:12:01,730",
        "quote": "那这次如果呃9月份那个加息。"
      },
      {
        "cue_id": 264,
        "time_range": "00:12:01,730 --> 00:12:05,630",
        "quote": "啊，宣布了那星期四的时候，然后然宣布9月份加息了。"
      },
      {
        "cue_id": 265,
        "time_range": "00:12:05,710 --> 00:12:07,630",
        "quote": "当然现在还没有这个结果啊。"
      },
      {
        "cue_id": 266,
        "time_range": "00:12:07,630 --> 00:12:10,430",
        "quote": "我相信呢那个时候大家再去回看。"
      },
      {
        "cue_id": 267,
        "time_range": "00:12:10,930 --> 00:12:11,940",
        "quote": "今天。"
      },
      {
        "cue_id": 268,
        "time_range": "00:12:11,940 --> 00:12:13,870",
        "quote": "啊，这9月15号。"
      },
      {
        "cue_id": 269,
        "time_range": "00:12:13,870 --> 00:12:16,930",
        "quote": "9月17号出结果，9月15号两天之前。"
      }
    ],
    "initial_disposition": "active",
    "numeric_policy": "All literal numbers, units, modal and negation tokens remain in unmodified quotes; no inferred conversion.",
    "assertion_time": "UNKNOWN",
    "referenced_time": "UNKNOWN_UNLESS_EXPLICIT_IN_QUOTES",
    "external_truth": "NOT_VERIFIED"
  },
  {
    "claim_id": "EP002/C02",
    "normalized_statement": "博主认为央行负责人会考虑自己的职业利益，不能只按其与总统的关系推断政策。",
    "quotes": [
      {
        "cue_id": 23,
        "time_range": "00:01:55,310 --> 00:02:00,850",
        "quote": "我的分析啊7月份的时候跟大家分析的，我认为呢它没有这个胆量，也没有这个一必要。"
      },
      {
        "cue_id": 24,
        "time_range": "00:02:00,850 --> 00:02:02,710",
        "quote": "为啥呢？来日方长嘛。"
      },
      {
        "cue_id": 25,
        "time_range": "00:02:02,710 --> 00:02:04,950",
        "quote": "他刚上任才多长时间呢？"
      },
      {
        "cue_id": 26,
        "time_range": "00:02:04,950 --> 00:02:07,050",
        "quote": "他未来任期有10年呢。"
      },
      {
        "cue_id": 27,
        "time_range": "00:02:07,050 --> 00:02:07,830",
        "quote": "对吧。"
      },
      {
        "cue_id": 28,
        "time_range": "00:02:07,830 --> 00:02:08,970",
        "quote": "你把自己的。"
      },
      {
        "cue_id": 29,
        "time_range": "00:02:08,970 --> 00:02:12,810",
        "quote": "整个的这个利益全部绑定在特朗普身上。"
      },
      {
        "cue_id": 30,
        "time_range": "00:02:12,820 --> 00:02:15,350",
        "quote": "这是非常非常不智的。如果特朗普。"
      },
      {
        "cue_id": 44,
        "time_range": "00:02:48,580 --> 00:02:51,680",
        "quote": "但显然这个剧情不是按照这个剧本走的呀。"
      },
      {
        "cue_id": 45,
        "time_range": "00:02:51,680 --> 00:02:54,680",
        "quote": "特朗普早早的就把自己的政治信誉透支了呀。"
      },
      {
        "cue_id": 46,
        "time_range": "00:02:54,680 --> 00:02:56,430",
        "quote": "让所有人都看出来他的。"
      },
      {
        "cue_id": 47,
        "time_range": "00:02:56,430 --> 00:02:57,250",
        "quote": "角色了呀。"
      }
    ],
    "initial_disposition": "active",
    "numeric_policy": "All literal numbers, units, modal and negation tokens remain in unmodified quotes; no inferred conversion.",
    "assertion_time": "UNKNOWN",
    "referenced_time": "UNKNOWN_UNLESS_EXPLICIT_IN_QUOTES",
    "external_truth": "NOT_VERIFIED"
  },
  {
    "claim_id": "EP002/C03",
    "normalized_statement": "谈判消息、否认与收益率变化的事件叙述，人名、数值及对应关系需核对。",
    "quotes": [
      {
        "cue_id": 48,
        "time_range": "00:02:57,290 --> 00:03:02,180",
        "quote": "昨天出了一个最搞笑的一幕，这个我今天下午会好好的讲啊。"
      },
      {
        "cue_id": 49,
        "time_range": "00:03:02,180 --> 00:03:03,000",
        "quote": "那啥呢？"
      },
      {
        "cue_id": 50,
        "time_range": "00:03:03,030 --> 00:03:05,100",
        "quote": "特朗普突然之间憋不住了。"
      },
      {
        "cue_id": 51,
        "time_range": "00:03:05,100 --> 00:03:06,820",
        "quote": "出来说伊朗要谈判。"
      },
      {
        "cue_id": 52,
        "time_range": "00:03:06,980 --> 00:03:12,390",
        "quote": "啊，伊朗这个衰弱的伊朗帝国是吧？要赶紧的跟我来谈判了。"
      },
      {
        "cue_id": 53,
        "time_range": "00:03:12,390 --> 00:03:17,840",
        "quote": "我对谈判保持着开放的意见是吧？你朗找我谈可以谈呢，没关系，可以谈的。"
      },
      {
        "cue_id": 54,
        "time_range": "00:03:17,840 --> 00:03:19,500",
        "quote": "他释放完了以后呢。"
      },
      {
        "cue_id": 55,
        "time_range": "00:03:19,500 --> 00:03:24,980",
        "quote": "十年期美债的收益率当时一破呀一度的话是突破了5%啊5%的。"
      },
      {
        "cue_id": 56,
        "time_range": "00:03:25,130 --> 00:03:28,430",
        "quote": "结果特朗普一说，伊朗要找到美国谈判。"
      },
      {
        "cue_id": 57,
        "time_range": "00:03:28,430 --> 00:03:31,910",
        "quote": "1年去美债收益率应声而跌，跌到4.9%。"
      },
      {
        "cue_id": 58,
        "time_range": "00:03:31,910 --> 00:03:32,740",
        "quote": "啊。"
      },
      {
        "cue_id": 59,
        "time_range": "00:03:32,740 --> 00:03:33,440",
        "quote": "然后呢。"
      },
      {
        "cue_id": 60,
        "time_range": "00:03:33,440 --> 00:03:36,710",
        "quote": "伊朗这边特朗普这边说了，前脚说了。"
      },
      {
        "cue_id": 61,
        "time_range": "00:03:36,710 --> 00:03:40,660",
        "quote": "不到5分钟，伊朗这边就反驳伊特朗普驳斥伊特朗普。"
      },
      {
        "cue_id": 62,
        "time_range": "00:03:40,660 --> 00:03:42,880",
        "quote": "官方出来说说没有的事儿。"
      },
      {
        "cue_id": 63,
        "time_range": "00:03:42,880 --> 00:03:45,830",
        "quote": "伊朗根本就没有跟美国有任何官方的沟通。"
      },
      {
        "cue_id": 64,
        "time_range": "00:03:45,830 --> 00:03:46,110",
        "quote": "あ？"
      },
      {
        "cue_id": 65,
        "time_range": "00:03:46,110 --> 00:03:47,600",
        "quote": "那说明两个问题嘛。"
      },
      {
        "cue_id": 66,
        "time_range": "00:03:47,600 --> 00:03:53,010",
        "quote": "伊朗这边刚高强度的在搜特朗普的发言嘛，一直在盯着特朗普在说啥吧。"
      },
      {
        "cue_id": 67,
        "time_range": "00:03:53,010 --> 00:03:57,060",
        "quote": "另外一个的话，伊朗这边早就防止特朗普在这边搞这个事情嘛。"
      },
      {
        "cue_id": 68,
        "time_range": "00:03:57,060 --> 00:04:00,010",
        "quote": "假这个假假他人之口。"
      },
      {
        "cue_id": 69,
        "time_range": "00:04:00,010 --> 00:04:02,120",
        "quote": "说啊，伊朗要跟美国谈。"
      },
      {
        "cue_id": 70,
        "time_range": "00:04:02,120 --> 00:04:08,900",
        "quote": "实际上呢就是拆台告诉你，实际上真正想谈的是美国嘛。那为啥美国想谈这答案不是摆明摆着呢吗？"
      }
    ],
    "initial_disposition": "deferred",
    "numeric_policy": "All literal numbers, units, modal and negation tokens remain in unmodified quotes; no inferred conversion.",
    "assertion_time": "UNKNOWN",
    "referenced_time": "UNKNOWN_UNLESS_EXPLICIT_IN_QUOTES",
    "external_truth": "NOT_VERIFIED"
  },
  {
    "claim_id": "EP002/C04",
    "normalized_statement": "博主认为电动车等替代减少原油需求，影响油价上升空间。",
    "quotes": [
      {
        "cue_id": 92,
        "time_range": "00:05:00,070 --> 00:05:03,080",
        "quote": "那这边受到影响了以后，我们这边一方面呢。"
      },
      {
        "cue_id": 93,
        "time_range": "00:05:03,080 --> 00:05:04,300",
        "quote": "新能源推广。"
      },
      {
        "cue_id": 94,
        "time_range": "00:05:04,320 --> 00:05:06,450",
        "quote": "把需求这边降了很多，对吧？"
      },
      {
        "cue_id": 95,
        "time_range": "00:05:06,450 --> 00:05:10,820",
        "quote": "你油价上来了以后，市场动态平衡嘛，油价涨了以后，新能源就车就卖的好嘛。"
      },
      {
        "cue_id": 96,
        "time_range": "00:05:10,820 --> 00:05:12,040",
        "quote": "那加油的就少嘛。"
      },
      {
        "cue_id": 97,
        "time_range": "00:05:12,040 --> 00:05:13,460",
        "quote": "需求就变少了嘛。"
      }
    ],
    "initial_disposition": "active",
    "numeric_policy": "All literal numbers, units, modal and negation tokens remain in unmodified quotes; no inferred conversion.",
    "assertion_time": "UNKNOWN",
    "referenced_time": "UNKNOWN_UNLESS_EXPLICIT_IN_QUOTES",
    "external_truth": "NOT_VERIFIED"
  },
  {
    "claim_id": "EP002/C05",
    "normalized_statement": "博主从中国重新补库存推测其他国家库存可能不足；这是推测，未证实。",
    "quotes": [
      {
        "cue_id": 120,
        "time_range": "00:06:08,400 --> 00:06:12,120",
        "quote": "那既然这种直接的威胁，直接就比在咽喉上的。"
      },
      {
        "cue_id": 121,
        "time_range": "00:06:12,120 --> 00:06:16,370",
        "quote": "那中国肯定是做了多手准备，防止霍尔木斯惨峡这边的石油中断嘛。"
      },
      {
        "cue_id": 122,
        "time_range": "00:06:16,370 --> 00:06:17,790",
        "quote": "那现在石油中断了。"
      },
      {
        "cue_id": 123,
        "time_range": "00:06:17,790 --> 00:06:20,790",
        "quote": "中国这边经过了这半年时间，现在也开开始。"
      },
      {
        "cue_id": 124,
        "time_range": "00:06:20,790 --> 00:06:22,900",
        "quote": "告诉你开始进行一个库存补充了。"
      },
      {
        "cue_id": 125,
        "time_range": "00:06:22,900 --> 00:06:23,530",
        "quote": "那就。"
      },
      {
        "cue_id": 126,
        "time_range": "00:06:23,530 --> 00:06:26,110",
        "quote": "实际上是提前的宣告大家。"
      },
      {
        "cue_id": 127,
        "time_range": "00:06:26,110 --> 00:06:27,960",
        "quote": "经过我们的官方测算。"
      },
      {
        "cue_id": 128,
        "time_range": "00:06:27,960 --> 00:06:32,620",
        "quote": "全世界其他的国家，这个石油的这个库库存也基本上快见底了。"
      },
      {
        "cue_id": 129,
        "time_range": "00:06:32,630 --> 00:06:33,430",
        "quote": "对吧。"
      },
      {
        "cue_id": 130,
        "time_range": "00:06:33,430 --> 00:06:35,170",
        "quote": "这才是真正的威胁。"
      }
    ],
