  "blogger_units": [
    {
      "id": "B01",
      "title": "执行约束与参与者利益",
      "statement": "博主从盟友能源依赖、贸易利益与制裁覆盖成本推断经济封锁难以奏效。",
      "quotes": [
        {
          "cue_id": 2,
          "time_range": "00:00:20,070 --> 00:00:40,070",
          "quote": "美国弃之这种啊这个武装冲突的方式不用啊，因为打了也打不出什么结果来嘛，你又不愿意去冲这个贪。最后的结果的话，那咱们换个方式然后换经济的方式去封锁伊朗。我当时做了节目说这个封锁也不会成功，但是美国人要试一试，对吧？当时我指出来嘛，你封锁的话，面临的最大的问题就是法不责众。"
        },
        {
          "cue_id": 3,
          "time_range": "00:00:40,070 --> 00:01:00,000",
          "quote": "伊朗很容易就能绕开你这个东西，他直接宣布霍尔木宰亚收费，通过的船都给我交钱，你到底管还是不管，对吧？你是宣宣传那种二级制裁也好啊，还是直接制裁也好啊，伊朗说必须得跟我伊朗的银行汇款，你才能通过霍尔兹海峡，那这些汇赂款的这些企业，这些国家，你美国要不要管。"
        },
        {
          "cue_id": 4,
          "time_range": "00:01:00,000 --> 00:01:04,750",
          "quote": "要管的话，就是把自己的朋友圈越做越小嘛，最后的结果是搬起石头砸自己的脚，对吧？"
        },
        {
          "cue_id": 23,
          "time_range": "00:01:59,240 --> 00:02:02,810",
          "quote": "要求所有的美国的盟友要孤立伊朗。"
        },
        {
          "cue_id": 24,
          "time_range": "00:02:02,810 --> 00:02:07,190",
          "quote": "大家嘴上面都没有反对，对吧？但实际上手上没有动作啊。"
        },
        {
          "cue_id": 48,
          "time_range": "00:03:14,470 --> 00:03:17,060",
          "quote": "按照泰国跟伊朗之间的贸易。"
        },
        {
          "cue_id": 49,
          "time_range": "00:03:17,120 --> 00:03:21,150",
          "quote": "那那贝申特要求说，断绝跟伊朗的所有的贸易往来。"
        },
        {
          "cue_id": 50,
          "time_range": "00:03:21,290 --> 00:03:23,570",
          "quote": "泰国说臣妾我做不到。"
        },
        {
          "cue_id": 51,
          "time_range": "00:03:23,570 --> 00:03:27,070",
          "quote": "很多事情还是有赖于伊朗这边的能源供给的。"
        },
        {
          "cue_id": 52,
          "time_range": "00:03:27,070 --> 00:03:29,440",
          "quote": "泰国如此，土耳其更是如此。"
        },
        {
          "cue_id": 55,
          "time_range": "00:03:41,530 --> 00:03:44,380",
          "quote": "该有航班往来的有航班往来。"
        },
        {
          "cue_id": 56,
          "time_range": "00:03:44,380 --> 00:03:49,950",
          "quote": "该有贸易往来的有贸易往来，要充分利用由与美伊之间的动荡。"
        },
        {
          "cue_id": 57,
          "time_range": "00:03:49,950 --> 00:03:54,650",
          "quote": "产生的土耳其这种十字路口地位骤然上升的这种有利条件。"
        },
        {
          "cue_id": 64,
          "time_range": "00:04:09,360 --> 00:04:12,170",
          "quote": "那个银行伊朗银行啊的这些分行。"
        },
        {
          "cue_id": 65,
          "time_range": "00:04:12,170 --> 00:04:15,670",
          "quote": "照常运转照常的这个经营业务。"
        },
        {
          "cue_id": 66,
          "time_range": "00:04:15,700 --> 00:04:19,200",
          "quote": "这事儿的话，说句心里话，就是啪啪打你美国的脸。"
        },
        {
          "cue_id": 67,
          "time_range": "00:04:19,210 --> 00:04:21,570",
          "quote": "结果呢你美国还没有什么办法。"
        }
      ],
      "attribution": "BLOGGER_VIA_UNCORRECTED_ASR",
      "external_truth": "NOT_VERIFIED",
      "boundary": "这些贸易与银行活动是博主叙述，未独立核实；不要把解释直接升级为政策无效的事实。"
    },
    {
      "id": "B02",
      "title": "替代工具与下台阶",
      "statement": "博主把由军事行动转向经济封锁解释为缓和冲突的台阶，并认为重新交火暴露了这一路径的困境。",
      "quotes": [
        {
          "cue_id": 11,
          "time_range": "00:01:24,650 --> 00:01:30,990",
          "quote": "如果考虑到这个是美国需要的一个台阶，需要把这个冲突缓和的一个台阶的话。"
        },
        {
          "cue_id": 12,
          "time_range": "00:01:30,990 --> 00:01:33,580",
          "quote": "你采取这样的手段，这样做这样的尝试。"
        },
        {
          "cue_id": 13,
          "time_range": "00:01:33,580 --> 00:01:37,030",
          "quote": "也无不可，对吧？只要你丢得起这个人也无不可。"
        },
        {
          "cue_id": 14,
          "time_range": "00:01:37,030 --> 00:01:39,470",
          "quote": "那现在呢这个剧情的话就是最坏的剧情。"
        },
        {
          "cue_id": 15,
          "time_range": "00:01:39,960 --> 00:01:41,550",
          "quote": "一方面的人丢了。"
        },
        {
          "cue_id": 16,
          "time_range": "00:01:41,570 --> 00:01:43,700",
          "quote": "另一方面呢，又重新开始打了。"
        },
        {
          "cue_id": 18,
          "time_range": "00:01:44,240 --> 00:01:47,680",
          "quote": "那重新开始打了，那你前面那个经济资产还要不要继续呢？"
        },
        {
          "cue_id": 71,
          "time_range": "00:04:26,970 --> 00:04:31,720",
          "quote": "啊，经过了这么长时间，对伊朗的封锁，你有什么新的领悟？贝森特说啥呢？"
        },
        {
          "cue_id": 72,
          "time_range": "00:04:31,720 --> 00:04:37,020",
          "quote": "我封锁伊朗的目的是想让伊朗的政府清醒清醒，好好的跟我们坐下来谈判。"
        },
        {
          "cue_id": 73,
          "time_range": "00:04:37,380 --> 00:04:43,290",
          "quote": "不谈判是你主子特朗普自己说的，说我们不愿意跟伊朗谈判，伊朗都是些神经病。"
        },
        {
          "cue_id": 74,
          "time_range": "00:04:43,290 --> 00:04:50,720",
          "quote": "结果呢，你贝森特在财长峰会的时候，我们希望跟伊朗谈判，我希望通过制裁的方式，让伊朗政府清醒的认识到现在的局势。"
        },
        {
          "cue_id": 75,
          "time_range": "00:04:50,720 --> 00:04:52,060",
          "quote": "然后坐下来跟我们谈判。"
        },
        {
          "cue_id": 76,
          "time_range": "00:04:52,110 --> 00:04:55,400",
          "quote": "这到底是在说伊朗政府还是在说美国自己？"
        },
        {
          "cue_id": 139,
          "time_range": "00:08:13,930 --> 00:08:18,470",
          "quote": "马上呢在军事上面又再次的回到了之前武力对峙的方向。"
        },
        {
          "cue_id": 140,
          "time_range": "00:08:18,470 --> 00:08:22,610",
          "quote": "这是不是就证明了前面的那个所谓的经济封锁已经破产了？"
        },
        {
          "cue_id": 141,
          "time_range": "00:08:22,610 --> 00:08:23,660",
          "quote": "没用了。"
        },
        {
          "cue_id": 143,
          "time_range": "00:08:24,300 --> 00:08:28,100",
          "quote": "那经济封锁没用了，武装力量又没办法占得上风。"
        }
      ],
      "attribution": "BLOGGER_VIA_UNCORRECTED_ASR",
      "external_truth": "NOT_VERIFIED",
      "boundary": "“台阶”“破产”是博主归因与判断；重启冲突并不单独证明经济措施必然无效。"
    },
    {
      "id": "B03",
      "title": "手段与目标不匹配后的动机推断",
      "statement": "博主质疑所述行动能否消除公开理由中的问题，并进一步把话语和动作解释为转移关注或回避另一承诺。",
      "quotes": [
        {
          "cue_id": 100,
          "time_range": "00:06:04,610 --> 00:06:07,970",
          "quote": "这事儿的话姑且认为它是真的啊，但是还是那句话。"
        },
        {
          "cue_id": 101,
          "time_range": "00:06:08,050 --> 00:06:10,840",
          "quote": "要在霍容采霞上布水雷的方法。"
        },
        {
          "cue_id": 102,
          "time_range": "00:06:10,840 --> 00:06:15,570",
          "quote": "用火箭弹发射只是一个比较简单粗暴的方法，不是唯一的方法。"
        },
        {
          "cue_id": 107,
          "time_range": "00:06:29,670 --> 00:06:32,540",
          "quote": "但是显然你没这样的决心，也没这样的手段。"
        },
        {
          "cue_id": 109,
          "time_range": "00:06:33,370 --> 00:06:35,550",
          "quote": "那你摧毁这个水雷的目的是啥呢？"
        },
        {
          "cue_id": 110,
          "time_range": "00:06:35,550 --> 00:06:38,460",
          "quote": "其实不是真的要阻止水雷被布下去。"
        },
        {
          "cue_id": 111,
          "time_range": "00:06:38,460 --> 00:06:42,650",
          "quote": "而是通过这件事情把大家的关注点引到水雷这个问题上来。"
        },
        {
          "cue_id": 112,
          "time_range": "00:06:42,650 --> 00:06:43,780",
          "quote": "你就是不想。"
        },
        {
          "cue_id": 113,
          "time_range": "00:06:43,780 --> 00:06:48,110",
          "quote": "通过告诉你是吧，我已经清除了这个水道，这个水道上已经没有水雷了。"
        },
        {
          "cue_id": 114,
          "time_range": "00:06:48,110 --> 00:06:50,390",
          "quote": "然后我就可以进行一个军舰护航了。"
        },
        {
          "cue_id": 115,
          "time_range": "00:06:50,390 --> 00:06:51,400",
          "quote": "反而呢。"
        },
        {
          "cue_id": 116,
          "time_range": "00:06:51,400 --> 00:06:55,270",
          "quote": "到你前脚宣布这个水道已经被清除干净了，后脚宣布。"
        },
        {
          "cue_id": 117,
          "time_range": "00:06:55,270 --> 00:07:00,920",
          "quote": "伊朗这边在铺重新铺设水雷，所以呢这个水稻依然对军舰来说不安全，我们可以不护航。"
        },
        {
          "cue_id": 118,
          "time_range": "00:07:00,920 --> 00:07:01,740",
          "quote": "对吧。"
        },
        {
          "cue_id": 119,
          "time_range": "00:07:02,070 --> 00:07:03,860",
          "quote": "本质上来是这么回事吧。"
        }
      ],
      "attribution": "BLOGGER_VIA_UNCORRECTED_ASR",
      "external_truth": "NOT_VERIFIED",
      "boundary": "原话推断强度较高；缺少充分实现目标的措施，不足以独立证明隐藏动机。仅比较推理方法，不提供军事操作建议。"
    },
    {
      "id": "B04",
      "title": "从相互行动判断主导权",
      "statement": "博主比较双方行动与回应，并判断局面向伊朗倾斜；又联系盟友没有响应制裁的叙述。",
      "quotes": [
        {
          "cue_id": 120,
          "time_range": "00:07:03,920 --> 00:07:06,770",
          "quote": "而这些事情其实都在告诉大家。"
        },
        {
          "cue_id": 121,
          "time_range": "00:07:06,770 --> 00:07:10,540",
          "quote": "整个霍尔木斯海峡的主导权是在伊朗这边说了算的。"
        },
        {
          "cue_id": 122,
          "time_range": "00:07:10,540 --> 00:07:12,430",
          "quote": "而且呢伊朗不仅仅。"
        },
        {
          "cue_id": 123,
          "time_range": "00:07:12,430 --> 00:07:15,450",
          "quote": "有主导或者我们讲下开关的权利了。"
        },
        {
          "cue_id": 124,
          "time_range": "00:07:15,450 --> 00:07:19,460",
          "quote": "现在有引匿美国下场交火的权利了。"
        },
        {
          "cue_id": 125,
          "time_range": "00:07:19,540 --> 00:07:25,220",
          "quote": "你美国打的是伊朗的，在霍尔兹海峡里边的那个关键的岛屿，对吧？"
        },
        {
          "cue_id": 126,
          "time_range": "00:07:25,220 --> 00:07:30,010",
          "quote": "但是伊朗打的是啥呢？伊朗打的是远在天边约旦的美军基地。"
        },
        {
          "cue_id": 128,
          "time_range": "00:07:34,510 --> 00:07:40,580",
          "quote": "这个打的目标哪个轻，哪个重，哪个更加的亮哪呃亮眼。"
        },
        {
          "cue_id": 129,
          "time_range": "00:07:40,580 --> 00:07:44,250",
          "quote": "哪个更加的挑战极限，哪个更加的无所谓。"
        },
        {
          "cue_id": 130,
          "time_range": "00:07:44,250 --> 00:07:46,580",
          "quote": "这不是肉眼一看就能看出来吗。"
        },
        {
          "cue_id": 131,
          "time_range": "00:07:46,580 --> 00:07:50,290",
          "quote": "所以现在中东的局势实际上已经在向着伊朗边倾斜了。"
        },
        {
          "cue_id": 132,
          "time_range": "00:07:50,290 --> 00:07:55,110",
          "quote": "再向着伊朗倾斜的时候，海湾国家的态度非常非常的暧昧。"
        },
        {
          "cue_id": 133,
          "time_range": "00:07:55,110 --> 00:07:59,030",
          "quote": "你高调的一开，所有跟伊朗做生意的，我们都要制裁。"
        },
        {
          "cue_id": 134,
          "time_range": "00:07:59,030 --> 00:08:00,660",
          "quote": "结果呢无人响应。"
        },
        {
          "cue_id": 135,
          "time_range": "00:08:00,660 --> 00:08:04,270",
          "quote": "该干该该干嘛的干嘛，阿联酋跟伊朗做生意。"
        },
        {
          "cue_id": 136,
          "time_range": "00:08:04,270 --> 00:08:07,610",
          "quote": "呃，土耳其跟伊朗通知航，你都没办法制裁。"
        }
      ],
      "attribution": "BLOGGER_VIA_UNCORRECTED_ASR",
      "external_truth": "NOT_VERIFIED",
      "boundary": "这是博主对力量与主导权的解释，不是本包已验证的战况结论。"
    },
    {
      "id": "B05",
      "title": "外部能力与信用传导",
      "statement": "博主把对外施压受限联系到难以向外转移内部问题，再用这一机制解释美债承压。",
      "quotes": [
        {
          "cue_id": 148,
          "time_range": "00:08:40,070 --> 00:08:42,640",
          "quote": "最近一段时间，美债的暴跌。"
        },
        {
          "cue_id": 149,
          "time_range": "00:08:42,640 --> 00:08:45,020",
          "quote": "他从长端美债30年级。"
        },
        {
          "cue_id": 150,
          "time_range": "00:08:45,020 --> 00:08:46,670",
          "quote": "蔓延到10年级。"
        },
        {
          "cue_id": 151,
          "time_range": "00:08:46,770 --> 00:08:50,090",
          "quote": "这些问题实际上就是大家对于美国。"
        },
        {
          "cue_id": 152,
          "time_range": "00:08:50,190 --> 00:08:53,050",
          "quote": "解决问题勇气的怀疑。"
        },
        {
          "cue_id": 153,
          "time_range": "00:08:53,050 --> 00:08:55,670",
          "quote": "这个解决问题不仅仅是对于。"
        },
        {
          "cue_id": 154,
          "time_range": "00:08:55,670 --> 00:08:57,800",
          "quote": "外部的问题还要对于内部的问题。"
        },
        {
          "cue_id": 155,
          "time_range": "00:08:57,800 --> 00:08:58,490",
          "quote": "对吧。"
        },
        {
          "cue_id": 156,
          "time_range": "00:08:58,490 --> 00:09:01,890",
          "quote": "之前你自己内部的问题解决不了，大家都默认了。"
        },
        {
          "cue_id": 157,
          "time_range": "00:09:01,890 --> 00:09:07,870",
          "quote": "但是承认呢你有把自己内部问题转化到外部，让其他人帮你承担结果的这个能力。"
        },
        {
          "cue_id": 158,
          "time_range": "00:09:07,870 --> 00:09:08,820",
          "quote": "所以呢。"
        },
        {
          "cue_id": 159,
          "time_range": "00:09:08,820 --> 00:09:12,670",
          "quote": "你说的那些东西，你的那些债务的话不会受到太多的冲击。"
        },
        {
          "cue_id": 160,
          "time_range": "00:09:12,670 --> 00:09:15,490",
          "quote": "你发行那些债务的话，也不会受到太多的怀疑。"
        },
        {
          "cue_id": 161,
          "time_range": "00:09:15,580 --> 00:09:17,830",
          "quote": "但是现在当你不敢冲台。"
        },
        {
          "cue_id": 162,
          "time_range": "00:09:17,930 --> 00:09:23,150",
          "quote": "那不敢冲单，其实下一步就是你自己内部的问题，没办法转化成别人的问题。"
        },
        {
          "cue_id": 163,
          "time_range": "00:09:23,220 --> 00:09:25,940",
          "quote": "我的问题没办法变成你的问题。因为。"
        },
        {
          "cue_id": 164,
          "time_range": "00:09:25,940 --> 00:09:29,700",
          "quote": "你没有这种勇气用武力来威胁别人的，或者说呢。"
        },
        {
          "cue_id": 165,
          "time_range": "00:09:29,700 --> 00:09:30,840",
          "quote": "你只能够。"
        },
        {
          "cue_id": 166,
          "time_range": "00:09:30,840 --> 00:09:32,030",
          "quote": "摆个花架子。"
        },
        {
          "cue_id": 167,
          "time_range": "00:09:32,030 --> 00:09:33,070",
          "quote": "通过一些。"
        },
        {
          "cue_id": 168,
          "time_range": "00:09:33,070 --> 00:09:35,690",
          "quote": "啊，营养辣枪头的东西来威慑别人。"
        },
        {
          "cue_id": 169,
          "time_range": "00:09:35,690 --> 00:09:36,570",
          "quote": "这个东西。"
        },
        {
          "cue_id": 170,
          "time_range": "00:09:36,570 --> 00:09:37,670",
          "quote": "不顶用的。"
        },
        {
          "cue_id": 171,
          "time_range": "00:09:37,670 --> 00:09:40,290",
          "quote": "威慑起来的话，需要别人的配合，或者呢。"
        },
        {
          "cue_id": 172,
          "time_range": "00:09:40,290 --> 00:09:44,320",
          "quote": "需要离岸平衡的配合，你需要他的正规的对手来配合。"
        },
        {
          "cue_id": 173,
          "time_range": "00:09:44,320 --> 00:09:47,550",
          "quote": "跟着你一起混合双谈，才有机可乘，对吧？"
        },
        {
          "cue_id": 174,
          "time_range": "00:09:47,630 --> 00:09:51,440",
          "quote": "这样的场景适用的对象是非常单一的。"
        },
        {
          "cue_id": 175,
          "time_range": "00:09:51,440 --> 00:09:53,130",
          "quote": "就像日本韩国有机会。"
        },
        {
          "cue_id": 176,
          "time_range": "00:09:53,140 --> 00:09:55,860",
          "quote": "其他的地方呢，其实你很难有机会。"
        },
        {
          "cue_id": 177,
          "time_range": "00:09:55,860 --> 00:10:00,180",
          "quote": "而只是去掐日本和韩国的话，解决不了你现在的眼见危机。"
        }
      ],
      "attribution": "BLOGGER_VIA_UNCORRECTED_ASR",
