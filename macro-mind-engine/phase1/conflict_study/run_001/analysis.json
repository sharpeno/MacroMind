        {
          "cue": 153,
          "time": "00:05:57.55 --> 00:06:0.34",
          "text": "伊朗未来发展的空间更大啊"
        },
        {
          "cue": 180,
          "time": "00:06:58.97 --> 00:07:0.29",
          "text": "这个事情的话"
        },
        {
          "cue": 181,
          "time": "00:07:0.29 --> 00:07:2.90",
          "text": "其实就是在挖这个伊朗的根儿啊"
        },
        {
          "cue": 182,
          "time": "00:07:2.90 --> 00:07:6.20",
          "text": "你沙特把未来的这个机会一个个都占了先机"
        },
        {
          "cue": 183,
          "time": "00:07:6.20 --> 00:07:9.56",
          "text": "伊朗呢因为你过去的这个几十年的封锁"
        },
        {
          "cue": 184,
          "time": "00:07:9.56 --> 00:07:12.72",
          "text": "又穷又又又又没钱是吧"
        },
        {
          "cue": 185,
          "time": "00:07:12.72 --> 00:07:14.67",
          "text": "又没有这个外边投资的机会"
        },
        {
          "cue": 186,
          "time": "00:07:14.67 --> 00:07:16.08",
          "text": "美国的敌对着你"
        },
        {
          "cue": 187,
          "time": "00:07:16.08 --> 00:07:18.51",
          "text": "那自然而然的沙特就是一步领先"
        },
        {
          "cue": 188,
          "time": "00:07:18.51 --> 00:07:19.23",
          "text": "步步领先"
        },
        {
          "cue": 189,
          "time": "00:07:19.23 --> 00:07:20.01",
          "text": "那未来的话"
        },
        {
          "cue": 190,
          "time": "00:07:20.01 --> 00:07:24.83",
          "text": "他还是可以垄断住这个嗯中东霸主的地位了"
        },
        {
          "cue": 191,
          "time": "00:07:24.83 --> 00:07:27.84",
          "text": "这起码沙特自己的小算盘是这么打的吧对吧"
        }
      ],
      "human_approval": "NOT_REVIEWED"
    },
    {
      "id": "D08",
      "episode": "455",
      "method": "M05",
      "claim": "把伊朗领导人表态视为支持力量显化，认为控制局势的难度上升。",
      "attribution": "BLOGGER_VIEW_ASSISTANT_EXTRACTION_NOT_VERIFIED_FACT",
      "assessment": "十颗星到二十颗星属于修辞尺度，不是可计算风险翻倍。表态也不证明直接参战或事前指挥。",
      "evidence": [
        {
          "cue": 383,
          "time": "00:14:40.22 --> 00:14:42.14",
          "text": "目前呢作为伊朗宣布是吧"
        },
        {
          "cue": 384,
          "time": "00:14:42.14 --> 00:14:45.08",
          "text": "哈梅内伊作为这个伊朗的精神领袖"
        },
        {
          "cue": 385,
          "time": "00:14:45.08 --> 00:14:47.00",
          "text": "他在推特上发了这个文章"
        },
        {
          "cue": 386,
          "time": "00:14:47.00 --> 00:14:50.22",
          "text": "直接点名了这个巴勒斯坦的青年人"
        },
        {
          "cue": 387,
          "time": "00:14:50.22 --> 00:14:52.08",
          "text": "这80年来最热血的青年人"
        },
        {
          "cue": 388,
          "time": "00:14:52.08 --> 00:14:53.21",
          "text": "这个话说了以后"
        },
        {
          "cue": 389,
          "time": "00:14:53.21 --> 00:14:55.97",
          "text": "基本上算是伊朗亮明了身份呐"
        },
        {
          "cue": 390,
          "time": "00:14:55.97 --> 00:14:57.75",
          "text": "半官方的直接下场了"
        },
        {
          "cue": 394,
          "time": "00:15:4.73 --> 00:15:8.21",
          "text": "如果说今天上午伊朗在没有直接宣布是吧"
        },
        {
          "cue": 395,
          "time": "00:15:8.21 --> 00:15:11.12",
          "text": "精神领袖亮亮明底牌的时候啊"
        },
        {
          "cue": 396,
          "time": "00:15:11.12 --> 00:15:13.34",
          "text": "以色列要解决这些问题的难度啊"
        },
        {
          "cue": 397,
          "time": "00:15:13.34 --> 00:15:15.56",
          "text": "就顺利的按照他的预意愿"
        },
        {
          "cue": 398,
          "time": "00:15:15.56 --> 00:15:17.00",
          "text": "对他最有利的方案"
        },
        {
          "cue": 399,
          "time": "00:15:17.00 --> 00:15:19.25",
          "text": "解决这个问题的难度是十颗星的话"
        },
        {
          "cue": 400,
          "time": "00:15:19.25 --> 00:15:21.56",
          "text": "那随着伊朗的哈梅内伊说这个话"
        },
        {
          "cue": 401,
          "time": "00:15:21.56 --> 00:15:23.80",
          "text": "这个难度就直接跳成20颗星了"
        }
      ],
      "human_approval": "NOT_REVIEWED"
    },
