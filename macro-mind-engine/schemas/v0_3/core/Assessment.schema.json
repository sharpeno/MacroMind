    "VerificationStatus": {
      "enum": [
        "verified",
        "likely_true",
        "uncertain",
        "disputed",
        "likely_false",
        "false",
        "unverifiable",
        "unknown"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
